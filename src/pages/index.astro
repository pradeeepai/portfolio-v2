---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
---

<Base
  title={`${profile.name} · ${profile.role}`}
  description="Senior DevOps Engineer with 5+ years of AWS experience. Container migrations, CI/CD pipelines, infrastructure as code, and AWS cost reduction."
>
  <Header />
  <main id="main">
    <Hero />
    <CaseStudy />
    <Services />
    <Process />
    <Certifications />
    <Contact />
  </main>
  <Footer />
</Base>

---
import { caseStudy } from '../data/profile';

const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
const saving = caseStudy.costBefore - caseStudy.costAfter;
const bars = [
  { label: 'Before', value: caseStudy.costBefore, tone: 'before' },
  { label: 'After', value: caseStudy.costAfter, tone: 'after' },
];
const opName = { '+': 'added', '-': 'removed', '~': 'unchanged' } as const;
---

<section class="section wrap" id="work" aria-labelledby="work-title">
  <p class="section-tag label">Case study</p>
  <div class="section-body">
    <h2 class="section-title" id="work-title">{caseStudy.title}</h2>

    <dl class="meta">
      {
        caseStudy.meta.map((item) => (
          <div>
            <dt class="label">{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>

    <figure class="cost">
      <figcaption class="label">Monthly AWS cost</figcaption>
      <div class="bars">
        {
          bars.map((bar) => (
            <div class="bar-row">
              <span class="bar-label">{bar.label}</span>
              <span class="track">
                <span
                  class:list={['bar', bar.tone]}
                  style={`width: ${(bar.value / caseStudy.costBefore) * 100}%`}
                />
              </span>
              <span class="bar-value">{usd(bar.value)}</span>
            </div>
          ))
        }
      </div>
      <p class="saving">
        Saving: <strong>{usd(saving)} per month</strong> ({usd(saving * 12)} per year)
      </p>
    </figure>

    <div class="block">
      <h3 class="sub">Context</h3>
      <div class="prose">
        {caseStudy.context.map((line) => <p>{line}</p>)}
      </div>
    </div>

    <div class="block">
      <h3 class="sub">Work done</h3>
      <ul class="list">
        {caseStudy.work.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="block">
      <h3 class="sub">Why ECS with the EC2 launch type</h3>
      <p class="prose">{caseStudy.decision}</p>
    </div>

    <div class="block">
      <h3 class="sub">Change summary</h3>
      <div class="diff" role="table" aria-label="Infrastructure changes">
        {
          caseStudy.diff.map((line) => (
            <div class:list={['line', opName[line.op as keyof typeof opName]]} role="row">
              <span class="op" role="cell" aria-label={opName[line.op as keyof typeof opName]}>
                {line.op}
              </span>
              <span class="key" role="cell">
                {line.key}
              </span>
              <span class="val" role="cell">
                {line.value}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="block">
      <h3 class="sub">Next-phase items identified</h3>
      <ul class="findings">
        {
          caseStudy.nextSteps.map((item) => (
            <li>
              <p>{item.issue}</p>
              <p class="fix">
                <span class="label">Fix</span> {item.fix}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0;
  }

  .meta div {
    display: grid;
    gap: 0.125rem;
  }

  .meta dd {
    margin: 0;
    font-weight: 600;
  }

  .cost {
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    background: var(--surface);
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }

  .bars {
    display: grid;
    gap: 0.625rem;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 4.5rem;
    gap: 0.75rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .bar-value {
    text-align: right;
    font-weight: 500;
  }

  .track {
    display: block;
    height: 1.5rem;
  }

  .bar {
    display: block;
    height: 100%;
  }

  .bar.before {
    background: repeating-linear-gradient(
      -45deg,
      var(--muted) 0 2px,
      transparent 2px 6px
    );
    border: 1px solid var(--muted);
  }

  .bar.after {
    background: var(--accent);
  }

  .saving {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .saving strong {
    color: var(--ink);
  }

  .diff {
    overflow-x: auto;
    border: 1px solid var(--rule);
    background: var(--surface);
    padding-block: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 52rem;
  }

  .line {
    display: grid;
    grid-template-columns: 2rem 11rem max-content;
    padding: 0.125rem 1rem 0.125rem 0;
    white-space: nowrap;
    min-width: max-content;
  }

  .op {
    text-align: center;
    font-weight: 500;
  }

  .key {
    color: var(--muted);
  }

  .added {
    background: color-mix(in srgb, var(--add) 12%, transparent);
  }

  .added .op {
    color: var(--add);
  }

  .removed {
    background: color-mix(in srgb, var(--del) 10%, transparent);
  }

  .removed .op {
    color: var(--del);
  }

  .unchanged .op {
    color: var(--mod);
  }

  .findings {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
    max-width: 65ch;
  }

  .findings li {
    display: grid;
    gap: 0.375rem;
    padding-left: 1rem;
    border-left: 2px solid var(--rule);
  }

  .fix {
    color: var(--muted);
  }

  .fix .label {
    color: var(--ink);
    margin-right: 0.25rem;
  }

  @media (max-width: 560px) {
    .cost {
      padding: 1rem;
    }

    .line {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      padding-block: 0.25rem;
      white-space: normal;
      min-width: 0;
    }

    .val {
      grid-column: 2;
    }
  }
</style>

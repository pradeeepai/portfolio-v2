---
import { steps } from '../data/profile';
---

<section class="section wrap" id="process" aria-labelledby="process-title">
  <p class="section-tag label">Process</p>
  <div class="section-body">
    <h2 class="section-title" id="process-title">How a project runs</h2>
    <ol class="steps">
      {
        steps.map((item, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.step}</h3>
            <p>{item.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 2rem;
  }

  li {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.4;
  }

  p {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>

---
import { services } from '../data/profile';
---

<section class="section wrap" id="services" aria-labelledby="services-title">
  <p class="section-tag label">Services</p>
  <div class="section-body">
    <h2 class="section-title" id="services-title">What I do for clients</h2>
    <ul class="rows">
      {
        services.map((service) => (
          <li class="row">
            <h3 class="area">{service.area}</h3>
            <div class="detail">
              <p>{service.work}</p>
              <ul class="chips" aria-label={`${service.area} tools`}>
                {service.tools.map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .row {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .area {
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.4;
  }

  .detail {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
